{
  "name": "Xero to Asana | Automated Financial Report Generation",
  "flow": [
    {
      "id": 1,
      "module": "asana:watchNewCompletedTasks",
      "version": 2,
      "parameters": {
        "page": 10,
        "filter": "project",
        "project": null,
        "__IMTCONN__": null,
        "workspaceRPC": null,
        "modified_since": null,
        "completed_since": null
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        },
        "restore": {},
        "parameters": [
          {
            "name": "__IMTCONN__",
            "type": "account:asana",
            "label": "Connection",
            "required": true
          },
          {
            "name": "filter",
            "type": "select",
            "label": "Filter",
            "required": true,
            "validate": {
              "enum": [
                "workspaceassignee",
                "project",
                "section",
                "tag"
              ]
            }
          },
          {
            "name": "completed_since",
            "type": "date",
            "label": "Completed Since"
          },
          {
            "name": "modified_since",
            "type": "date",
            "label": "Modified Since "
          },
          {
            "name": "page",
            "type": "uinteger",
            "label": "Limit",
            "required": true
          },
          {
            "name": "workspaceRPC",
            "type": "select",
            "label": "Workspace",
            "required": true
          },
          {
            "name": "project",
            "type": "select",
            "label": "Project ID",
            "required": true
          }
        ]
      }
    },
    {
      "id": 4,
      "module": "datastore:AddRecord",
      "version": 1,
      "parameters": {
        "datastore": null
      },
      "mapper": {
        "key": "{{1.gid}}",
        "data": {
          "offset": "0",
          "has_more": true,
          "task_gid": "{{1.gid}}",
          "report_year": "2026",
          "last_journal_number": "0"
        },
        "overwrite": true
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        },
        "restore": {
          "expect": {
            "data": {
              "nested": {
                "has_more": {
                  "mode": "chose"
                }
              }
            },
            "overwrite": {
              "mode": "chose"
            }
          }
        },
        "parameters": [
          {
            "name": "datastore",
            "type": "datastore",
            "label": "Data store",
            "required": true
          }
        ],
        "expect": [
          {
            "name": "key",
            "type": "text",
            "label": "Key"
          },
          {
            "name": "overwrite",
            "type": "boolean",
            "label": "Overwrite an existing record",
            "required": true
          },
          {
            "name": "data",
            "spec": [
              {
                "name": "offset",
                "type": "number",
                "label": null
              },
              {
                "name": "last_journal_number",
                "type": "number",
                "label": null
              },
              {
                "name": "has_more",
                "type": "boolean",
                "label": null
              },
              {
                "name": "task_gid",
                "type": "text",
                "label": null
              },
              {
                "name": "report_year",
                "type": "number",
                "label": null
              }
            ],
            "type": "collection",
            "label": "Record"
          }
        ]
      }
    },
    {
      "id": 3,
      "module": "builtin:BasicRepeater",
      "version": 1,
      "parameters": {},
      "mapper": {
        "step": "1",
        "start": "1",
        "repeats": "3"
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0
        },
        "restore": {},
        "expect": [
          {
            "name": "start",
            "type": "number",
            "label": "Initial value",
            "required": true
          },
          {
            "name": "repeats",
            "type": "number",
            "label": "Repeats",
            "required": true,
            "validate": {
              "max": 10000,
              "min": 0
            }
          },
          {
            "name": "step",
            "type": "number",
            "label": "Step",
            "required": true
          }
        ]
      }
    },
    {
      "id": 5,
      "module": "datastore:GetRecord",
      "version": 1,
      "parameters": {
        "datastore": null
      },
      "mapper": {
        "key": "{{1.gid}}",
        "returnWrapped": false
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0
        },
        "restore": {},
        "parameters": [
          {
            "name": "datastore",
            "type": "datastore",
            "label": "Data store",
            "required": true
          }
        ],
        "expect": [
          {
            "name": "key",
            "type": "text",
            "label": "Key",
            "required": true
          },
          {
            "name": "returnWrapped",
            "type": "boolean",
            "label": "Return Wrapped Output",
            "required": true
          }
        ],
        "interface": [
          {
            "help": "",
            "name": "offset",
            "type": "number",
            "label": null,
            "default": null,
            "required": false
          },
          {
            "help": "",
            "name": "last_journal_number",
            "type": "number",
            "label": null,
            "default": null,
            "required": false
          },
          {
            "help": "",
            "name": "has_more",
            "type": "boolean",
            "label": null,
            "required": false
          },
          {
            "help": "",
            "name": "task_gid",
            "type": "text",
            "label": null,
            "default": null,
            "required": false,
            "multiline": false
          },
          {
            "help": "",
            "name": "report_year",
            "type": "number",
            "label": null,
            "default": null,
            "required": false
          }
        ]
      }
    },
    {
      "id": 2,
      "module": "xero:MakeAPICall",
      "version": 2,
      "parameters": {
        "__IMTCONN__": null
      },
      "filter": {
        "name": "Continue Journal Pagination",
        "conditions": [
          [
            {
              "a": "{{5.has_more}}",
              "b": "true",
              "o": "boolean:equal"
            }
          ]
        ]
      },
      "mapper": {
        "url": "/2.0/Journals?offset={{5.offset}}",
        "type": "text",
        "method": "GET",
        "baseUrl": "api.xro",
        "headers": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "tenantId": null,
        "responseType": "json"
      },
      "metadata": {
        "designer": {
          "x": 1200,
          "y": 0
        },
        "restore": {
          "expect": {
            "qs": {
              "mode": "chose"
            },
            "type": {
              "mode": "chose",
              "label": "text"
            },
            "method": {
              "mode": "chose",
              "label": "GET"
            },
            "baseUrl": {
              "mode": "chose",
              "label": "api.xro"
            },
            "headers": {
              "mode": "chose",
              "items": [
                null
              ]
            },
            "responseType": {
              "mode": "chose",
              "label": "json"
            }
          }
        },
        "parameters": [
          {
            "name": "__IMTCONN__",
            "type": "account:xero3",
            "label": "Connection",
            "required": true
          }
        ],
        "expect": [
          {
            "name": "tenantId",
            "type": "select",
            "label": "Organization",
            "required": true
          },
          {
            "name": "baseUrl",
            "type": "select",
            "label": "Base URL",
            "required": true,
            "validate": {
              "enum": [
                "api.xro",
                "payroll.xro",
                "assets.xro",
                "files.xro",
                "projects.xro",
                "bankfeeds.xro"
              ]
            }
          },
          {
            "name": "method",
            "type": "select",
            "label": "Method",
            "required": true,
            "validate": {
              "enum": [
                "GET",
                "POST",
                "PUT",
                "PATCH",
                "DELETE"
              ]
            }
          },
          {
            "name": "headers",
            "spec": [
              {
                "name": "key",
                "type": "text",
                "label": "Key"
              },
              {
                "name": "value",
                "type": "text",
                "label": "Value"
              }
            ],
            "type": "array",
            "label": "Headers"
          },
          {
            "name": "qs",
            "spec": [
              {
                "name": "key",
                "type": "text",
                "label": "Key"
              },
              {
                "name": "value",
                "type": "text",
                "label": "Value"
              }
            ],
            "type": "array",
            "label": "Query String"
          },
          {
            "name": "type",
            "type": "select",
            "label": "Request type",
            "validate": {
              "enum": [
                "text",
                "json",
                "urlencoded",
                "multipart/form-data"
              ]
            }
          },
          {
            "name": "responseType",
            "type": "select",
            "label": "Response type",
            "validate": {
              "enum": [
                "json",
                "text",
                "binary"
              ]
            }
          },
          {
            "name": "body",
            "type": "any",
            "label": "Body"
          },
          {
            "name": "url",
            "type": "text",
            "label": "URL",
            "required": true
          }
        ]
      }
    },
    {
      "id": 6,
      "module": "datastore:AddRecord",
      "version": 1,
      "parameters": {
        "datastore": null
      },
      "filter": {
        "name": "Journal Records Exist",
        "conditions": [
          [
            {
              "a": "{{length(2.body.Journals)}}",
              "b": "0",
              "o": "number:greater"
            }
          ]
        ]
      },
      "mapper": {
        "key": "{{1.gid}}",
        "data": {
          "offset": "{{get(last(2.body.Journals); \"JournalNumber\")}}",
          "has_more": "{{length(2.body.Journals)}} = 100",
          "task_gid": "{{1.gid}}",
          "report_year": "2026",
          "last_journal_number": "{{get(last(2.body.Journals); \"JournalNumber\")}}"
        },
        "overwrite": true
      },
      "metadata": {
        "designer": {
          "x": 1500,
          "y": 0
        },
        "restore": {
          "expect": {
            "data": {
              "nested": {
                "has_more": {
                  "mode": "edit"
                }
              }
            },
            "overwrite": {
              "mode": "chose"
            }
          }
        },
        "parameters": [
          {
            "name": "datastore",
            "type": "datastore",
            "label": "Data store",
            "required": true
          }
        ],
        "expect": [
          {
            "name": "key",
            "type": "text",
            "label": "Key"
          },
          {
            "name": "overwrite",
            "type": "boolean",
            "label": "Overwrite an existing record",
            "required": true
          },
          {
            "name": "data",
            "spec": [
              {
                "name": "offset",
                "type": "number",
                "label": null
              },
              {
                "name": "last_journal_number",
                "type": "number",
                "label": null
              },
              {
                "name": "has_more",
                "type": "boolean",
                "label": null
              },
              {
                "name": "task_gid",
                "type": "text",
                "label": null
              },
              {
                "name": "report_year",
                "type": "number",
                "label": null
              }
            ],
            "type": "collection",
            "label": "Record"
          }
        ]
      }
    },
    {
      "id": 8,
      "module": "builtin:BasicFeeder",
      "version": 1,
      "parameters": {},
      "mapper": {
        "array": "{{2.body.Journals}}"
      },
      "metadata": {
        "designer": {
          "x": 1800,
          "y": 0
        },
        "restore": {
          "expect": {
            "array": {
              "mode": "edit"
            }
          }
        },
        "expect": [
          {
            "mode": "edit",
            "name": "array",
            "spec": [],
            "type": "array",
            "label": "Array"
          }
        ]
      }
    },
    {
      "id": 9,
      "module": "builtin:BasicFeeder",
      "version": 1,
      "parameters": {},
      "filter": {
        "name": "Demo Journal Transactions - 2026",
        "conditions": [
          [
            {
              "a": "{{parseNumber(substring(8.JournalDate; 6; 19); \".\")}}",
              "b": "1767225600000",
              "o": "number:greaterorequal"
            },
            {
              "a": "{{parseNumber(substring(8.JournalDate; 6; 19); \".\")}}",
              "b": "1798761600000",
              "o": "number:less"
            }
          ]
        ]
      },
      "mapper": {
        "array": "{{8.JournalLines}}"
      },
      "metadata": {
        "designer": {
          "x": 2100,
          "y": 0
        },
        "restore": {
          "expect": {
            "array": {
              "mode": "edit"
            }
          }
        },
        "expect": [
          {
            "mode": "edit",
            "name": "array",
            "spec": [],
            "type": "array",
            "label": "Array"
          }
        ]
      }
    },
    {
      "id": 10,
      "module": "csv:CreateAdvancedAggregator",
      "version": 1,
      "parameters": {
        "type": null,
        "feeder": 3,
        "newlineType": "CRLF",
        "delimiterType": ",",
        "includeHeaders": true
      },
      "mapper": {
        "Debit": "{{if(9.NetAmount + \" > 0\"; 9.NetAmount; 0)}}",
        "Credit": "{{if(9.NetAmount + \" < 0\"; abs(9.NetAmount); 0)}}",
        "NetAmount": "{{9.NetAmount}}",
        "AccountCode": "{{9.AccountCode}}",
        "AccountName": "{{9.AccountName}}",
        "Description": "{{9.Description}}",
        "JournalDate": "{{formatDate(parseDate(substring(8.JournalDate; 6; 19); \"\"\"x\"\"\"); \"\"\"YYYY-MM-DD\"\" \"; \"\"\"UTC\"\"\")}}",
        "JournalNumber": "{{8.JournalNumber}}"
      },
      "metadata": {
        "designer": {
          "x": 2400,
          "y": 0
        },
        "restore": {
          "extra": {
            "feeder": {
              "label": "Repeater [3]"
            }
          }
        },
        "parameters": [
          {
            "name": "type",
            "type": "udt",
            "label": "Data structure",
            "required": true
          },
          {
            "name": "includeHeaders",
            "type": "boolean",
            "label": "Include headers in the first row",
            "required": true
          },
          {
            "name": "delimiterType",
            "type": "select",
            "label": "Delimiter",
            "required": true,
            "validate": {
              "enum": [
                ",",
                "\t",
                "other"
              ]
            }
          },
          {
            "name": "newlineType",
            "type": "select",
            "label": "Newline",
            "required": true,
            "validate": {
              "enum": [
                "LF",
                "CRLF"
              ]
            }
          }
        ],
        "expect": [
          {
            "name": "JournalNumber",
            "type": "text",
            "label": null
          },
          {
            "name": "JournalDate",
            "type": "text",
            "label": null
          },
          {
            "name": "AccountCode",
            "type": "text",
            "label": null
          },
          {
            "name": "AccountName",
            "type": "text",
            "label": null
          },
          {
            "name": "Description",
            "type": "text",
            "label": null
          },
          {
            "name": "Debit",
            "type": "number",
            "label": null
          },
          {
            "name": "Credit",
            "type": "number",
            "label": null
          },
          {
            "name": "NetAmount",
            "type": "number",
            "label": null
          }
        ]
      }
    },
    {
      "id": 12,
      "module": "asana:UploadAttachment",
      "version": 2,
      "parameters": {
        "__IMTCONN__": null
      },
      "mapper": {
        "task_gid": "{{1.gid}}",
        "file_data": "{{10.text}}",
        "file_name": "Xero_Journal_2026_TEST.csv",
        "selectOrMap": "map"
      },
      "metadata": {
        "designer": {
          "x": 2700,
          "y": 0
        },
        "restore": {
          "expect": {
            "selectOrMap": {
              "label": "Enter manually"
            }
          }
        },
        "parameters": [
          {
            "name": "__IMTCONN__",
            "type": "account:asana",
            "label": "Connection",
            "required": true
          }
        ],
        "expect": [
          {
            "name": "selectOrMap",
            "type": "select",
            "label": "Enter a Task ID",
            "required": true,
            "validate": {
              "enum": [
                "map",
                "select"
              ]
            }
          },
          {
            "name": "file_name",
            "type": "text",
            "label": "Name",
            "required": true
          },
          {
            "name": "file_data",
            "type": "buffer",
            "label": "Data",
            "required": true
          },
          {
            "name": "task_gid",
            "type": "text",
            "label": "Task ID",
            "required": true
          }
        ]
      }
    }
  ],
  "metadata": {
    "instant": false,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "slots": null,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": {
